[Unit]
Description=Mira Finance Verifier Demo (FastAPI, port 8001)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/mira-demo
ExecStart=/opt/mira-demo/venv/bin/uvicorn demo.finance_demo_app:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
