# LLM (TokenHub)
RAG_LLM_API_KEY=your_tokenhub_api_key_here
RAG_LLM_BASE_URL=https://tokenhub.itcast.cn/v1
RAG_LLM_MODEL=deepseek-v4-flash

# Embedding
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DEVICE=cpu

# API 鉴权 (启用后客户端请求必须带 X-API-Key / Bearer; 本机 127.0.0.1 直连免鉴权)
RAG_API_KEY_ENABLED=false
RAG_API_KEY=change_me

# 图谱持久化 HMAC 密钥 (整图 Redis/文件签名校验; 多 worker 经 Redis 共享图谱时必填, 否则各进程自签名互不认)
RAG_GRAPH_HMAC_SECRET=

# 速率限制 (慢速攻击/滥用防护) — slowapi 接入
# ⚠️ 生产部署强烈建议开启: RAG_RATE_LIMIT_ENABLED=true
#   默认关闭是因为单进程/内网/本地开发无需, 且开启后需配合 RAG_SHARED_STATE_BACKEND=redis 才能在多 worker 间共享计数。
#   RAG_RATE_LIMIT_PER_MINUTE 为单客户端 IP 每分钟请求上限 (默认 60)。
RAG_RATE_LIMIT_ENABLED=false
RAG_RATE_LIMIT_PER_MINUTE=60
