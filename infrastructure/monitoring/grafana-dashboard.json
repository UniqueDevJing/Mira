{
  "dashboard": {
    "uid": "rag-2.0",
    "title": "RAG 2.0 — 服务监控",
    "tags": ["rag", "fastapi", "llm"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "QA 请求速率",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "rate(rag_qa_requests_total[5m])",
            "legendFormat": "{{mode}} ({{status}})"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "decimals": 2
          }
        }
      },
      {
        "id": 2,
        "title": "QA 延迟 (P50 / P95 / P99)",
        "type": "timeseries",
        "gridPos": {"x": 6, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(rag_qa_latency_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(rag_qa_latency_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(rag_qa_latency_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {"lineWidth": 2}
          }
        }
      },
      {
        "id": 3,
        "title": "LLM Token 消耗速率",
        "type": "timeseries",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "rate(rag_llm_tokens_total[5m])",
            "legendFormat": "{{type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "tokens/s",
            "custom": {"fillOpacity": 20, "stacking": {"mode": "normal"}}
          }
        }
      },
      {
        "id": 4,
        "title": "QA 错误率",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 4, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(rate(rag_qa_requests_total{status='error'}[5m])) / sum(rate(rag_qa_requests_total[5m])) * 100",
            "legendFormat": "Error %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"value": null, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "检索轮数分布",
        "type": "bargauge",
        "gridPos": {"x": 0, "y": 8, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "rate(rag_retrieval_rounds_bucket[5m])",
            "legendFormat": "{{le}} rounds"
          }
        ]
      },
      {
        "id": 6,
        "title": "向量库大小",
        "type": "stat",
        "gridPos": {"x": 6, "y": 8, "w": 4, "h": 3},
        "targets": [
          {
            "expr": "rag_vector_store_size",
            "legendFormat": "Vectors"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 7,
        "title": "知识图谱规模",
        "type": "stat",
        "gridPos": {"x": 10, "y": 8, "w": 4, "h": 3},
        "targets": [
          {
            "expr": "rag_graph_nodes_count",
            "legendFormat": "Nodes"
          },
          {
            "expr": "rag_graph_edges_count",
            "legendFormat": "Edges"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 8,
        "title": "文档上传量",
        "type": "stat",
        "gridPos": {"x": 14, "y": 8, "w": 4, "h": 3},
        "targets": [
          {
            "expr": "rate(rag_document_uploads_total[1h])",
            "legendFormat": "{{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "docs/h"
          }
        }
      },
      {
        "id": 9,
        "title": "LLM 错误分布",
        "type": "piechart",
        "gridPos": {"x": 18, "y": 8, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum(rate(rag_llm_errors_total[5m])) by (error_type)",
            "legendFormat": "{{error_type}}"
          }
        ]
      },
      {
        "id": 10,
        "title": "回答忠实度分布 (P50 / P95)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(rag_qa_faithfulness_bucket[5m])) by (le))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(rag_qa_faithfulness_bucket[5m])) by (le))",
            "legendFormat": "P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "custom": {"lineWidth": 2}
          }
        }
      },
      {
        "id": 11,
        "title": "Top1 检索得分分布 (P50 / P95)",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(rag_qa_top1_score_bucket[5m])) by (le))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(rag_qa_top1_score_bucket[5m])) by (le))",
            "legendFormat": "P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "custom": {"lineWidth": 2}
          }
        }
      },
      {
        "id": 12,
        "title": "降级层级分布 (按 level 0/1/2/3)",
        "type": "bargauge",
        "gridPos": {"x": 0, "y": 22, "w": 24, "h": 5},
        "targets": [
          {
            "expr": "sum(rate(rag_degradation_levels_total[5m])) by (level)",
            "legendFormat": "level {{level}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops/s",
            "custom": {"fillOpacity": 80, "stacking": {"mode": "none"}}
          }
        }
      }
    ],
    "schemaVersion": 39,
    "refresh": "10s"
  }
}
