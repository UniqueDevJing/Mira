# 复制为 .env 并填入真实值 (docker compose 自动读取)
# RAG 2.0 部署环境变量示例

# 必填: 真实问答需要的 LLM Key (不填则 /ask 报错, 但 /health /metrics 正常)
RAG_LLM_API_KEY=sk-your-llm-key

# API Key 鉴权 (默认开启, fail-closed)
RAG_API_KEY_ENABLED=true
# 可选: KB 级 RBAC 白名单 JSON, 例: {"key1":{"name":"admin","role":"admin","kbs":"*"}}
RAG_API_KEY_WHITELIST=

# 共享态后端: memory(单实例) / redis(多实例会话一致)
RAG_SHARED_STATE_BACKEND=memory

# Grafana 登录 (生产务必改掉默认 admin/admin)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
