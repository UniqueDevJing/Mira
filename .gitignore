**/__pycache__/
*.pyc
.idea/
venv/
.env
.env/
*.db
milvus.db/
lancedb_data/
# 评测语料/导出等大体积数据 (85MB), 只保留生成脚本, 不入库
data/
data/eval-summary.json
# 召回门禁临时产物 (写在仓库根, 因挂载的语料目录可能只读)
.eval-gate-current.json
# 评估标注产物 (可能含答案, 不入库)
data/labeled.json
data/labeled_review.md
# 生产 QA 日志导出 (含真实问题与答案, 不入库)
data/qa_export.json
data/labeled_production.json
data/labeled_demo.json
*.log
# 会话临时产物
junit_*.xml
_pytest_*.log
_ptmp_*/
_dbg*.py
_probe*.py
*_out.txt
# 入库脚本运行时状态 (内容哈希)
.kb_seed_hash_state.json
.kb_hash_state.json
*.egg-info/
dist/
*.pdf
# 测试 fixtures 下的 PDF 需要入库 (测试依赖)
!tests/fixtures/*.pdf

# 测试输出缓存
tests/last_test_results.json

# 测试临时目录 (pytest-tmp 隔离产物, 数千文件: 不忽略会淹没 git status)
.pytest-tmp/
.pytest_cache/
.pytest_*/
.ruff_cache/
# 重构前源码备份
.refactor-backup/

# 本地模型权重 (体积大, 用 scripts/download_model.py 按需下载)
models/

# 覆盖率产物 (pytest-cov)
.coverage
.coverage.*
# 沙箱/本地绕过 safe-delete 拦截时的临时数据文件
.covdata
htmlcov/

# SQLite WAL 辅助文件 (journal_mode=WAL 生成, 不入库)
*.db-wal
*.db-shm

# 运行时持久化产物（BM25/图谱 pkl、SQLite 已由 *.db 覆盖）
data/*.pkl

# 本地工具目录（不入库）
.claude/
docs/superpowers/
